; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Starter Kit Racing"
config/tags=PackedStringArray("starterkit")
run/main_scene="uid://clq7nox1juh3a"
config/quit_on_go_back=false
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/bg_color=Color(0.921875, 0.921875, 0.957031, 1)
boot_splash/image="res://splash-screen.png"
config/icon="res://icon.png"
run/main_scene.xr="uid://d0j1llb4yr2rk"

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor]

movie_writer/movie_file="D:/Godot/recording.mp4.avi"
movie_writer/mjpeg_quality=1.0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/spatialize/plugin.cfg")

[filesystem]

import/fbx/enabled=false

