[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssao/fadeout_from=500.0
environment/ssao/fadeout_to=2000.0
anti_aliasing/quality/msaa_3d=1

[xr]

openxr/enabled=true
openxr/reference_space=2
openxr/environment_blend_mode=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/startup_alert=false
openxr/extensions/spatial_container/enabled=true
openxr/extensions/spatial_container/bounds=Vector3(0.9, 0.3, 0.9)
shaders/enabled=true
openxr/extensions/androidxr/spatial_trackpad_interaction=true
openxr/extensions/vendor_performance_metrics=true
openxr/startup_alert.xr=true
